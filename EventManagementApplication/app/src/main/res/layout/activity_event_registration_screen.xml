<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    tools:context=".EventRegistrationScreen">

    <EditText
        android:id="@+id/name"
        android:layout_width="374dp"
        android:layout_height="48dp"
        android:hint="Full Name" />

    <EditText
        android:id="@+id/phone"
        android:hint="Phone Number"
        android:inputType="phone"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <EditText
        android:id="@+id/email"
        android:hint="Email"
        android:inputType="textEmailAddress"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <Spinner
        android:id="@+id/eventType"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <Button
        android:id="@+id/dateBtn"
        android:text="Select Event Date"
        android:layout_width="match_parent"
        android:layout_height="48dp"/>

    <TextView
        android:id="@+id/dateText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No Date Selected"
        android:textSize="16sp"
        android:padding="10dp"/>

    <RadioGroup
        android:id="@+id/genderGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/male"
            android:text="Male" android:layout_height="48dp" android:layout_width="80dp"/>

        <RadioButton
            android:id="@+id/female"
            android:text="Female" android:layout_height="48dp" android:layout_width="90dp"/>

    </RadioGroup>

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@mipmap/ic_launcher"/>

    <Button
        android:id="@+id/uploadBtn"
        android:text="Upload Image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <CheckBox
        android:id="@+id/terms"
        android:layout_width="370dp"
        android:layout_height="wrap_content"
        android:text="Accept Terms and Conditions" />

    <Button
        android:id="@+id/submitBtn"
        android:text="Submit Registration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>